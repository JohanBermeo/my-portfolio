---
import ArrowUpIcon from '../assets/ArrowUpIcon.svg'
---
<section id="projects">
	<div id="projects-container">
        <div id="projects-header">
            <h4>MI TRABAJO</h4>
            <h2>Proyectos destacados</h2>
            <span></span>
            <p>Una selección de los proyectos en los que he trabajado, desde aplicaciones <br> empresariales hasta herramientas personales.</p>
        </div>

        <div id="projects-content">

        </div>

        <div id="projects-footer">
            <a href="https://github.com/JohanBermeo" target="_blank" id="projects-link">
                Ver más en GitHub <img src={ArrowUpIcon.src} alt="Arrow Up Icon" id="projects-link-icon" />
            </a>
        </div>
    </div>
</section>

<style>
    #projects-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        width: 100%;
        gap: 32px;
    }

    #projects-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
        margin-top: 96px;
        justify-content: center;
    }

    #projects-header h4 {
        color: #DB2727;
        font-size: 14px;
        font-family: "Bricolage Grotesque", sans-serif;
        line-height: 16px;
        margin: 0;
    }

    #projects-header h2 {
        color: #F5F0F0;
        font-size: 32px;
        font-family: "Space Grotesque", sans-serif;
        font-weight: 700;
        line-height: 48px;
        margin: 0;
    }

    #projects-header span {
        width: 48px;
        height: 1px;
        background-color: #DB2727;
    }

    #projects-header p {
        color: #717171;
        font-size: 14px;
        font-family: "Inter", sans-serif;
        font-weight: 400;
        line-height: 20px;
        margin: 16px 0 0;
        text-align: center;
    }

    #projects-footer {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        margin-bottom: 96px;
    }

    #projects-link {
        color: #717171;
        font-size: 14px;
        font-family: "Inter", sans-serif;
        font-weight: 500;
        text-decoration: none;
        line-height: 20px;
        display: flex;
        flex-direction: row;
        gap: 8px;
        align-items: center;
    }

    #projects-link-icon {
        width: 16px;
        height: 16px;
        filter: brightness(0) saturate(100%) invert(44%);
    }
</style>