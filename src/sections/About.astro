---
import expData from "../data/experience.json";
import Tag from "../components/Tag.astro";
import Exp from "../components/Exp.astro";
import CaseIcon from "../assets/CaseIcon.svg";
import AwardIcon from "../assets/AwardIcon.svg";
import CapIcon from "../assets/CapIcon.svg";
import BugIcon from "../assets/BugIcon.svg";
---

<section id="about">
    <div id="about-content">
        <div id="about-header">
            <h3 id="about-tag">QUIEN SOY</h3>
            <h2 id="about-title">Sobre mí</h2>
            <span id="about-tag-icon"></span>
        </div>

        <div id="about-main-container">
            <div id="about-left-container">
                <p>Desarrollador Full Stack y estudiante de Ingeniería de Sistemas en Bogotá, enfocado en liderar arquitecturas sólidas y experiencias digitales de alto impacto. Especializado en el desarrollo de backends escalables en Python, Java y NestJS, así como en la creación de interfaces dinámicas con Astro, React y Svelte, combino la coordinación de equipos técnicos con una pasión constante por la ingeniería limpia y la eficiencia de procesos.</p> 
                <br>
                <p>Más allá de la arquitectura de software y el código, me motiva el aprendizaje continuo, la contribución activa a la comunidad tecnológica y el intercambio de conocimiento dentro del ecosistema dev. Entiendo el desarrollo como un proceso integral de innovación constante, disciplina y colaboración técnica, donde cada línea de código responde a una estrategia clara para resolver problemas reales y generar valor tangible.</p>
                <div id="tag-container">
                    <Tag type="simple" title="1" subtitle="Año de experiencia" logo={CaseIcon}></Tag>
                    <Tag type="simple" title="5+" subtitle="Proyectos completados" logo={AwardIcon}></Tag>
                    <Tag type="simple" title="Ing." subtitle="Ingeniero de sistemas" logo={CapIcon}></Tag>
                    <Tag type="simple" title="∞" subtitle="Errores de compilación" logo={BugIcon}></Tag>
                </div>
            </div>
    
            <div id="about-right-container">
                <div id="about-selector">
                    <div class="button-container" data-active="education">
                        <div class="selector-line"></div>
                        <button class="selector-button active" id="btn-education" type="button" data-tab="education">
                            <span class="selector-label">ESTUDIOS</span>
                        </button>
                        <button class="selector-button" id="btn-experience" type="button" data-tab="experience">
                            <span class="selector-label">EXPERIENCIA</span>
                        </button>
                    </div>
                </div>

                <div id="exp-container">
                    <div id="tab-education" class="exp-tab-content active">
                        {expData.education.map((item) => (
                            <Exp 
                                type="study" 
                                title={item.title} 
                                subtitle={item.subtitle} 
                                date={item.date} 
                                text={item.text} 
                            />
                        ))}
                    </div>

                    <div id="tab-experience" class="exp-tab-content">
                        {expData.experience.map((item) => (
                            <Exp 
                                type="experience" 
                                title={item.title} 
                                subtitle={item.subtitle} 
                                date={item.date} 
                                text={item.text} 
                            />
                        ))}
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<script>
    function setupSelector() {
        const buttonContainer = document.querySelector(".button-container");
        const btnEducation = document.getElementById("btn-education");
        const btnExperience = document.getElementById("btn-experience");
        const tabEducation = document.getElementById("tab-education");
        const tabExperience = document.getElementById("tab-experience");

        if (btnEducation && btnExperience && buttonContainer && tabEducation && tabExperience) {
            btnEducation.addEventListener("click", () => {
                buttonContainer.setAttribute("data-active", "education");
                btnEducation.classList.add("active");
                btnExperience.classList.remove("active");
                
                tabEducation.classList.add("active");
                tabExperience.classList.remove("active");
            });

            btnExperience.addEventListener("click", () => {
                buttonContainer.setAttribute("data-active", "experience");
                btnExperience.classList.add("active");
                btnEducation.classList.remove("active");
                
                tabExperience.classList.add("active");
                tabEducation.classList.remove("active");
            });
        }
    }

    setupSelector();
    document.addEventListener("astro:page-load", setupSelector);
</script>

<style>
    #about {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: fit-content;
        background-color: #0D0606;
    }

    #about-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin: 96px 353px 0;
    }

    #about-tag {
        font-size: 14px;
        font-family: "Bricolage Grotesque", sans-serif;
        letter-spacing: 0.05em;
        line-height: 16px;
        color: #DC2626;
    }

    #about-title {
        font-size: 32px;
        font-family: "Space Grotesque", sans-serif;
        font-weight: 700;
        line-height: 48px;
        color: #F5F0F0;
        margin: 0;
    }

    #about-tag-icon {
		width: 32px;
		height: 1px;
		background-color: #DC2626;
		line-height: 24px;
        margin: 16px 0 0;
	}

    #about-main-container {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        justify-content: center;
        gap: 40px;
        margin: 64px 353px 96px;
    }

    #about-left-container {
        display: flex;
        flex-direction: column;
        width: 50%;
        height: fit-content;
    }

    #about-left-container p {
        font-size: 15px;
        font-family: "Inter", sans-serif;
        font-weight: 400;
        line-height: 27px;
        color: #9E9E9E;
        margin: 0;
    }

    #tag-container {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        grid-template-rows: repeat(2, 1fr);
        grid-gap: 16px;
        margin: 40px 0 0;
    }

    #about-right-container {
        display: flex;
        flex-direction: column;
        width: 50%;
        height: fit-content;
        gap: 24px;
    }

    #about-selector {
        display: flex;
        justify-content: flex-start;
        width: 100%;
    }

    .button-container {
        position: relative;
        display: flex;
        flex-direction: row;
        align-items: center;
        width: 100%;
        max-width: 320px;
        background-color: #150A0A;
        border: 1px solid #DC26261F;
        border-radius: 14px;
        padding: 4px;
        box-sizing: border-box;
    }

    .selector-line {
        position: absolute;
        top: 5px;
        bottom: 5px;
        left: 5px;
        width: calc(50% - 5px);
        background-color: #DC2626;
        border-radius: 10px;
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        z-index: 1;
        box-shadow: 0 2px 10px rgba(220, 38, 38, 0.35);
    }

    .button-container[data-active="experience"] .selector-line {
        transform: translateX(100%);
    }

    .selector-button {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        width: 50%;
        padding: 8px 16px;
        border: none;
        background: transparent;
        color: #717171;
        font-family: "Bricolage Grotesque", sans-serif;
        font-size: 14px;
        cursor: pointer;
        transition: color 0.25s ease;
    }

    .selector-button.active {
        color: #FFFFFF;
        font-weight: 600;
    }

    #exp-container {
        display: flex;
        flex-direction: column;
        width: 100%;
        margin-top: -10px;
    }

    .exp-tab-content {
        display: none;
        flex-direction: column;
        animation: fadeIn 0.3s ease-in-out;
    }

    .exp-tab-content.active {
        display: flex;
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(6px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>