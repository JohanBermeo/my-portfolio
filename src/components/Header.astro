---
import Logo from '../assets/Logo.webp';
---

<header id="header-container">
    <div id="header-content">
        <a href="/" class="logo-container">
            <img id="logo" src={Logo.src} alt="Logo" />
            <span id="first-name">JOHAN</span>
            <span id="last-name">BERMEO </span>
        </a>
        <div id="navigation-container">
            <nav id="navigation-links">
                <a href="#">Inicio</a>
                <a href="#">Sobre mí</a>
                <a href="#">Proyectos</a>
                <a href="#">Tecnologías</a>
                <button id="contact-button">Contáctame</button>
            </nav>
        </div>
    </div>
</header>

<style>
    #header-container {
        width: 100%;
    }
    
	#header-content {
		display: flex;
        flex-direction: row;
		justify-content: space-between;
		align-items: center;
        padding: 0 40px;
        margin: 0 313px;
        height: 64px;
	}

    .logo-container {
        display: flex;
        flex-direction: row;
        align-items: center;
        text-decoration: none;
    }

    #logo {
        height: 32px;
        width: 32px;
        margin-right: 8px;
    }

    #first-name {
        color: #FFFFFF;
        font-size: 14px;
        letter-spacing: 2.5px;
        font-family: "Bricolage Grotesque", sans-serif;
        font-weight: 600;
        margin-right: 4px;
    }

    #last-name {
        color: #DB2727;
        font-size: 14px;
        letter-spacing: 2.5px;
        font-family: "Bricolage Grotesque", sans-serif;
        font-weight: 600;
    }

    #navigation-container {
        display: flex;
        flex-direction: row;
        align-items: center;
    }

    #navigation-links {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 32px;
    }

    #navigation-links a {
        color: #9e9e9e;
        font-size: 14px;
        font-family: "Inter", sans-serif;
        font-weight: 500;
        text-decoration: none;
    }

    #contact-button {
        background-color: transparent;
        border: 1px solid #DB2727;
        border-radius: 4px;
        color: #DB2727;
        font-size: 14px;
        font-family: "Inter", sans-serif;
        font-weight: 500;
        padding: 8px 16px;
        line-height: 20px;
        cursor: pointer;
        border-radius: 10px;
    }

    #contact-button:hover {
        background-color: #DB2727;
        border-radius: 10px;
        color: #FFFFFF;
    }
</style>
