---
import Logo from '../assets/Logo.webp';
---

<header id="header-container">
    <div id="header-content">
        <a href="/" id="logo-container">
            <img id="logo" src={Logo.src} alt="Logo" />
            <span id="first-name">JOHAN</span>
            <span id="last-name">BERMEO </span>
        </a>
        <div id="navigation-container">
            <nav id="navigation-links">
                <a href="#">Inicio</a>
                <a href="#">Sobre mí</a>
                <a href="#">Proyectos</a>
                <a href="#">Tecnologías</a>
                <button id="contact-button">Contáctame</button>
            </nav>
        </div>
    </div>
</header>

<style>
    @keyframes borderFlash {
        0% {
            border-bottom: 1px solid rgba(255, 255, 255, 0.8);
            box-shadow: 0 2px 10px rgba(255, 255, 255, 0.2);
        }
        100% {
            border-bottom: 1px solid #280909;
            box-shadow: 0 0 0 rgba(255, 255, 255, 0);
        }
    }

    #header-container {
        width: 100%;
        position: fixed;
        top: 0;
        background-color: transparent;
        border-bottom: 1px solid transparent; /* Para evitar saltos cuando aparece el borde */
        z-index: 1000;
        transition: background-color 0.3s ease;
    }

    #header-container.scrolled {
        border-bottom: 1px solid #280909;
        background-color: #080404;
        animation: borderFlash 0.8s ease-out forwards;
    }

    #header-content {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
		align-items: center;
        background-color: transparent;
        padding: 0 40px;
        margin: 0 120px;
        height: 64px;
	}

    #logo-container {
        display: flex;
        flex-direction: row;
        align-items: center;
        text-decoration: none;
    }

    #logo {
        height: 32px;
        width: 32px;
        margin-right: 8px;
    }

    #first-name {
        color: #FFFFFF;
        font-size: 14px;
        letter-spacing: 2.5px;
        font-family: "Bricolage Grotesque", sans-serif;
        font-weight: 600;
        margin-right: 4px;
    }

    #last-name {
        color: #DB2727;
        font-size: 14px;
        letter-spacing: 2.5px;
        font-family: "Bricolage Grotesque", sans-serif;
        font-weight: 600;
    }

    #navigation-container {
        display: flex;
        flex-direction: row;
        align-items: center;
    }

    #navigation-links {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 32px;
    }

    #navigation-links a {
        color: #9e9e9e;
        font-size: 14px;
        font-family: "Inter", sans-serif;
        font-weight: 500;
        text-decoration: none;
    }

    #contact-button {
        background-color: transparent;
        border: 1px solid #DB2727;
        border-radius: 4px;
        color: #DB2727;
        font-size: 14px;
        font-family: "Inter", sans-serif;
        font-weight: 500;
        padding: 8px 16px;
        line-height: 20px;
        cursor: pointer;
        border-radius: 10px;
    }

    #contact-button:hover {
        background-color: #DB2727;
        border-radius: 10px;
        color: #FFFFFF;
    }
</style>

<script>
	// Run script when the DOM is fully loaded
	document.addEventListener('DOMContentLoaded', () => {
		const isHome = window.location.pathname === "/";
		
		// 1. Manejo del Scroll
		const handleScroll = () => {
			const navbar = document.getElementById('header-container');
			if (navbar) {
				if (window.scrollY > 40) {
					navbar.classList.add('scrolled');
				} else {
					navbar.classList.remove('scrolled');
				}
			}
		};

		window.addEventListener("scroll", handleScroll);
		handleScroll(); // Ejecutar una vez por si la página ya cargó con scroll
		
		// 2. Manejo de enlaces y scroll suave
		const navLinks = document.querySelectorAll('#navigation-links a'); 
		navLinks.forEach(link => {
			link.addEventListener('click', (e) => {
				const href = link.getAttribute('href');
				
				if (!href || !href.startsWith('#')) return;

				if (!isHome) {
					// Si no estás en home, redirigir a home + el ancla
					window.location.href = "/" + href;
					return;
				}
				
				// Si estás en home, hacer scroll suave
				e.preventDefault();
				const el = document.querySelector(href);
				if (el) el.scrollIntoView({ behavior: "smooth" });
			});
		});
	});
</script>
