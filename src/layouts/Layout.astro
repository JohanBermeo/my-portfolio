---
import Logo from '../assets/Logo.webp';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href={Logo.src} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,200..800&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
		<meta name="generator" content={Astro.generator} />
		<title>Johan Bermeo | Software Engineer</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	html {
		scroll-behavior: smooth;
		scrollbar-width: thin;
		scrollbar-color: #dc2626 #080404;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		background-color: #080404;
	}

	/* Modern Custom Scrollbar Kit */
	::-webkit-scrollbar {
		width: 10px;
		height: 10px;
	}

	::-webkit-scrollbar-track {
		background: #080404;
		border-left: 1px solid #1a0808;
	}

	::-webkit-scrollbar-thumb {
		background: linear-gradient(180deg, #dc2626 0%, #991b1b 100%);
		border-radius: 9999px;
		border: 2px solid #080404;
		transition: background 0.3s ease;
	}

	::-webkit-scrollbar-thumb:hover {
		background: linear-gradient(180deg, #ef4444 0%, #dc2626 100%);
		box-shadow: 0 0 10px rgba(220, 38, 38, 0.6);
	}

	::-webkit-scrollbar-thumb:active {
		background: #b91c1c;
	}

	::-webkit-scrollbar-corner {
		background: #080404;
	}
</style>


